#!/bin/sh
# One DualSense for the PS5 and Linux on IW620 (Marvell) consoles: Linux's own Bluetooth address,
# set with a vendor command to the Wi-Fi/Bluetooth combo chip at boot. Off by default from v1.4.1
# (suspected of breaking Wi-Fi on v1.4.0); MediaTek consoles always have it (kernel path).
#   ps5-bt-address on | off | status
F=/etc/ps5-bazzite-deck/bt-address
if lsusb 2>/dev/null | grep -q 1286:2059; then
    echo "This console has the IW620 Wi-Fi/Bluetooth chip: the Linux-only Bluetooth address isn't available on it"
    echo "(it left the chip hung after warm restarts). Pair the controller with Linux; it keeps one pairing."
    [ -e "$F" ] && sudo rm -f "$F"
    exit 0
fi
case "$1" in
    on)  sudo mkdir -p /etc/ps5-bazzite-deck && sudo touch "$F" && echo "Linux-only Bluetooth address on from the next boot: pair your controllers with Linux once more afterwards"
         echo "Note: on IW620 consoles the address change isn't always applied after a cold boot; if a paired"
         echo "controller then won't reconnect (\"Authentication Failure\" in btmon), run 'ps5-bt-address off',"
         echo "remove the pairing and pair once more." ;;
    off) sudo rm -f "$F" && echo "Linux-only Bluetooth address off from the next boot (the controller keeps one pairing)" ;;
    *)   if [ -e "$F" ]; then
             echo "Linux-only Bluetooth address: on"
             cur=$(cat /sys/class/bluetooth/hci0/address 2>/dev/null)
             [ -n "$cur" ] && echo "controller address now: $cur (if this is the PS5 system's address after a cold boot, the switch didn't apply)"
         else
             echo "Linux-only Bluetooth address: off (ps5-bt-address on to enable)"
         fi ;;
esac
