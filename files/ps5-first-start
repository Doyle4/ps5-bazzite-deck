#!/bin/sh
# First start only (Steam not set up yet): explain the blank screen with the blinking cursor.
# Powering off there is the most common reason for a broken first start (kishy, ObsessiveRug).
for f in /home/*/.local/share/Steam/steam.sh /home/*/.steam/steam/steam.sh; do [ -e "$f" ] && exit 0; done
MSG='

   PS5 Bazzite Deck: first start

   Steam is setting itself up and downloading its update in the background.
   This screen can stay like this for several minutes. Please do not power off.

'
[ -w /dev/tty1 ] && printf '%s' "$MSG" > /dev/tty1 2>/dev/null   # the console you see (not /dev/console too: same screen, twice)
exit 0
