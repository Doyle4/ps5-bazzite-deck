#!/bin/sh
# CPU boost, fan target and Wi-Fi power saving, applied at boot (v1.5; request: moonman7299, values
# after the ps5-hwcon-plugin by NotHavocc). Settings in /etc/ps5-bazzite-deck/perf.conf:
#   CPU_BOOST=1        allow the CPU's boost clocks (up to 3.5 GHz under load; the governor still idles down)
#   FAN_TARGET=85      fan target temperature in °C (40-90; lower = fan earlier and louder)
#   WIFI_POWERSAVE=0   keep Wi-Fi power saving off (Steam's developer toggle turns it back on; 1 = leave it alone)
#   ps5-perf status | on | off | apply | wifi   (off = boost as the kernel set it, the console's own fan target)
CONF=/etc/ps5-bazzite-deck/perf.conf
FAN=/sys/bus/platform/devices/ps5-fan/target_temp
ORIG=/var/lib/ps5-bazzite-deck/fan-target.orig
[ -f "$CONF" ] && . "$CONF"
CPU_BOOST=${CPU_BOOST:-1}; FAN_TARGET=${FAN_TARGET:-85}; ENABLED=${ENABLED:-1}; WIFI_POWERSAVE=${WIFI_POWERSAVE:-0}
# Wi-Fi power saving off on every wireless interface (wlan*, wlp*, the IW620's mlan*): up to ~700
# instead of ~100 Mbit/s. Called at boot, by the NetworkManager dispatcher when Wi-Fi comes up, and
# by a timer, because Steam's developer toggle switches it back on. Only acts when something is on.
wifi_off() {
    [ "$WIFI_POWERSAVE" = 0 ] || return 0
    for d in /sys/class/net/*; do
        [ -d "$d/wireless" ] || continue; n=${d##*/}
        if command -v iw >/dev/null && iw dev "$n" get power_save 2>/dev/null | grep -q ': on'; then
            iw dev "$n" set power_save off 2>/dev/null && echo "ps5-perf: Wi-Fi power saving switched off on $n"
        fi
        c=$(nmcli -t -f GENERAL.CONNECTION device show "$n" 2>/dev/null | cut -d: -f2-)
        if [ -n "$c" ] && ! nmcli -g 802-11-wireless.powersave connection show "$c" 2>/dev/null | grep -q '^2'; then
            nmcli connection modify "$c" 802-11-wireless.powersave 2 2>/dev/null && echo "ps5-perf: power saving off for the connection $c"
        fi
    done
}
boost_set() {   # global knob (acpi-cpufreq) and per-policy knobs (amd_pstate)
    for f in /sys/devices/system/cpu/cpufreq/boost /sys/devices/system/cpu/cpufreq/policy*/boost; do
        [ -w "$f" ] && echo "$1" > "$f" 2>/dev/null
    done
}
case "$1" in
    wifi)  wifi_off ;;
    apply)
        wifi_off
        [ "$ENABLED" = 1 ] || exit 0
        [ "$CPU_BOOST" = 1 ] && boost_set 1
        if [ -w "$FAN" ] && [ "$FAN_TARGET" -ge 40 ] 2>/dev/null && [ "$FAN_TARGET" -le 90 ]; then
            mkdir -p "$(dirname "$ORIG")"; [ -f "$ORIG" ] || cat "$FAN" > "$ORIG" 2>/dev/null
            echo "$FAN_TARGET" > "$FAN" && echo "ps5-perf: cpu boost $CPU_BOOST, fan target $FAN_TARGET °C (console default $(cat "$ORIG" 2>/dev/null) °C)"
        fi ;;
    on)  sudo mkdir -p "$(dirname "$CONF")"; sudo sed -i '/^ENABLED=/d' "$CONF" 2>/dev/null; echo "ENABLED=1" | sudo tee -a "$CONF" >/dev/null; sudo "$0" apply ;;
    off) sudo mkdir -p "$(dirname "$CONF")"; sudo sed -i '/^ENABLED=/d' "$CONF" 2>/dev/null; echo "ENABLED=0" | sudo tee -a "$CONF" >/dev/null
         [ -f "$ORIG" ] && sudo sh -c "cat $ORIG > $FAN" && echo "fan target back to the console's $(cat "$ORIG") °C"; echo "ps5-perf off (CPU boost stays as the kernel set it until the next boot)" ;;
    *)   echo "ps5-perf: $([ "$ENABLED" = 1 ] && echo on || echo off) (set in $CONF)"
         echo "  cpu boost: $(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || cat /sys/devices/system/cpu/cpufreq/policy0/boost 2>/dev/null || echo n/a), max clock $(( $(cat /sys/devices/system/cpu/cpufreq/policy0/cpuinfo_max_freq 2>/dev/null || echo 0) / 1000 )) MHz, governor $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null)"
         echo "  fan target: $(cat "$FAN" 2>/dev/null || echo n/a) °C (console default $(cat "$ORIG" 2>/dev/null || echo unknown))" ;;
esac
