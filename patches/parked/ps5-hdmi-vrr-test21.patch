PS5 VRR test 21: does the GPU really send a variable frame length?   [ps5-bazzite-deck, parked]

On top of the v1.5.1 kernel (which carries tests 6-20 behind hdmi.vrr_test=1). hsgodd's
question (B): if amdgpu never programs a variable frame length (DRR), the chip in VRR
mode gets fixed timing, which would explain both the FreeSync drift and the native
no-signal. Two log lines, only with hdmi.vrr_test=1:
 - every 2 s from the vblank interrupt: the measured frame intervals (avg/min/max) and
   whether they vary; at 60 fps on a 120 Hz mode, DRR gives ~16.7 ms, fixed timing 8.3 ms
 - at each VRR transition in the commit path: the frame-length range amdgpu programs
   (v_total_min/max vs the mode's v_total), the VRR state and range, ignore_msa
---

--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -4364,6 +4364,20 @@
 				dm->dc, acrtc_state->stream,
 				&acrtc_attach->dm_irq_params.vrr_params.adjust);
 			spin_unlock_irqrestore(&pcrtc->dev->event_lock, flags);
+#ifdef CONFIG_X86_PS5
+			/* VRR test 21: the frame-length range amdgpu programs (min != max = DRR) */
+			if (ps5_hdmi_vrr_possible()) {
+				const struct mod_vrr_params *v = &acrtc_attach->dm_irq_params.vrr_params;
+
+				drm_info(dev, "PS5 VRR DRR: commit: state %d, range %u-%u Hz, v_total_min %u, v_total_max %u (mode %u), ignore_msa %d => %s\n",
+					 v->state, v->min_refresh_in_uhz / 1000000, v->max_refresh_in_uhz / 1000000,
+					 v->adjust.v_total_min, v->adjust.v_total_max,
+					 acrtc_state->stream->timing.v_total,
+					 acrtc_state->stream->ignore_msa_timing_param,
+					 v->adjust.v_total_min && v->adjust.v_total_min != v->adjust.v_total_max ?
+					 "variable range requested" : "fixed");
+			}
+#endif
 		}
 		mutex_lock(&dm->dc_lock);
 		/*
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
@@ -2314,6 +2314,62 @@
  * dm_vupdate_high_irq(); on DCE it is driven by VLINE0 at the start of vblank
  * from dm_crtc_high_irq().
  */
+#ifdef CONFIG_X86_PS5
+/*
+ * VRR test 21 (hsgodd's question B): does the GPU really send a variable frame length?
+ * In VRR mode the vblank interval follows the game (16.7 ms at 60 fps on a 120 Hz mode);
+ * without DRR it stays at the mode's fixed period (8.3 ms). Measured in the vblank IRQ,
+ * logged every 2 s while hdmi.vrr_test=1.
+ */
+static struct {
+	ktime_t last, window;
+	u32 n, min_us, max_us;
+	u64 sum_us;
+	int vrr;
+} ps5_drr[6];
+
+static void ps5_vrr_drr_measure(struct amdgpu_crtc *acrtc, int vrr_active)
+{
+	unsigned int i = acrtc->crtc_id;
+	ktime_t now = ktime_get();
+	u32 us;
+
+	if (!ps5_hdmi_vrr_possible() || i >= ARRAY_SIZE(ps5_drr))
+		return;
+	if (ps5_drr[i].vrr != vrr_active || !ps5_drr[i].last) {
+		/* new window when VRR switches */
+		memset(&ps5_drr[i], 0, sizeof(ps5_drr[i]));
+		ps5_drr[i].vrr = vrr_active;
+		ps5_drr[i].last = ps5_drr[i].window = now;
+		return;
+	}
+	us = ktime_us_delta(now, ps5_drr[i].last);
+	ps5_drr[i].last = now;
+	if (us > 200000)		/* a stall, not a frame */
+		return;
+	if (!ps5_drr[i].n || us < ps5_drr[i].min_us)
+		ps5_drr[i].min_us = us;
+	if (us > ps5_drr[i].max_us)
+		ps5_drr[i].max_us = us;
+	ps5_drr[i].sum_us += us;
+	ps5_drr[i].n++;
+	if (ktime_ms_delta(now, ps5_drr[i].window) >= 2000 && ps5_drr[i].n) {
+		u32 avg = div_u64(ps5_drr[i].sum_us, ps5_drr[i].n);
+
+		pr_info("PS5 VRR DRR: crtc %u vrr_active=%d frames=%u vblank interval avg %u.%02u ms, min %u.%02u, max %u.%02u => %s\n",
+			i, vrr_active, ps5_drr[i].n, avg / 1000, (avg % 1000) / 10,
+			ps5_drr[i].min_us / 1000, (ps5_drr[i].min_us % 1000) / 10,
+			ps5_drr[i].max_us / 1000, (ps5_drr[i].max_us % 1000) / 10,
+			ps5_drr[i].max_us - ps5_drr[i].min_us > 1000 ? "frame length VARIES (DRR active)" :
+			"frame length FIXED");
+		ps5_drr[i].window = now;
+		ps5_drr[i].n = 0;
+		ps5_drr[i].sum_us = 0;
+		ps5_drr[i].min_us = ps5_drr[i].max_us = 0;
+	}
+}
+#endif
+
 static void dm_crtc_high_irq_handler(struct amdgpu_device *adev,
 				     struct amdgpu_crtc *acrtc)
 {
@@ -2345,6 +2401,9 @@
 	}
 
 	vrr_active = amdgpu_dm_crtc_vrr_active_irq(acrtc);
+#ifdef CONFIG_X86_PS5
+	ps5_vrr_drr_measure(acrtc, vrr_active);
+#endif
 
 	drm_dbg_vbl(adev_to_drm(adev),
 		    "crtc:%d, vupdate-vrr:%d, planes:%d\n", acrtc->crtc_id,
