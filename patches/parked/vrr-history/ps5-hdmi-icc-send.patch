PS5 HDMI: VRR test 26, send any HDMI ICC message at runtime (hdmi.icc_send)  [ps5-bazzite-deck]

Test 25 showed the EMC accepts stock's VRR arming sequence (4/16, id 0x30) but nothing
runs it: stored sequences only run through a trigger binding (4/2: sequence id ->
register bit), and our table binds 0x31-0x37 only. hsgodd's capture has no 4/x at mode
set, so the binding happens at init. To try registrations and bindings without a
rebuild: writing hex to /sys/module/hdmi/parameters/icc_send sends that HDMI ICC message
to the EMC right away (whole query with its header, or the I2C body) and logs the reply
("ICC send"). Root only, and only with hdmi.vrr_test=1 on FLAVA3.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -852,6 +852,56 @@
 static bool vrr_prep_keep;
 module_param(vrr_prep_keep, bool, 0644);
 MODULE_PARM_DESC(vrr_prep_keep, "VRR test 25b: also send our own pre-block after vrr_prep_raw");
+
+/*
+ * Test 26: send any HDMI ICC message right away, for experiments with the EMC's
+ * stored sequences (register a 4/16 sequence, bind it with 4/2, ...) without a
+ * rebuild. Write the message as hex to /sys/module/hdmi/parameters/icc_send: the whole
+ * query (its 12-byte header is replaced) or only the I2C body. The reply is logged
+ * ("ICC send"). Only with hdmi.vrr_test=1, root only. icc_query() serializes itself.
+ */
+static int icc_send_set(const char *val, const struct kernel_param *kp)
+{
+	static u8 body[480], buf[ICC_MSG_MAX_SIZE];
+	static DEFINE_MUTEX(icc_send_lock);
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	const char *p = val;
+	int n = 0, ret;
+
+	if (!vrr_test || hdmi_ic_type != HDMI_IC_TYPE_FLAVA3)
+		return -EPERM;
+	mutex_lock(&icc_send_lock);
+	while (n < (int)sizeof(body) && isxdigit(p[0]) && isxdigit(p[1])) {
+		body[n++] = hex_to_bin(p[0]) << 4 | hex_to_bin(p[1]);
+		p += 2;
+		while (*p == ' ' || *p == ':' || *p == ',')
+			p++;
+	}
+	if (n > 12 && (body[0] == 0x42 || body[0] == 0x00) && body[1] == ICC_SERVICE_ID_HDMI) {
+		memmove(body, body + 12, n - 12);
+		n -= 12;
+	}
+	if (n < 4) {
+		mutex_unlock(&icc_send_lock);
+		return -EINVAL;
+	}
+	memset(buf, 0, sizeof(buf));
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->msg_type = 0;
+	msg->length = sizeof(*msg) + n;
+	memcpy(msg->data, body, n);
+	if (icc_trace)
+		icc_trace_dump("query", buf);
+	ret = icc_query(buf, buf);
+	pr_info("ICC send (%d bytes): ret %d, reply %*ph\n", n, ret, 16, buf);
+	if (!ret && icc_trace)
+		icc_trace_dump("reply", buf);
+	mutex_unlock(&icc_send_lock);
+	return ret ? -EIO : 0;
+}
+static const struct kernel_param_ops icc_send_ops = { .set = icc_send_set };
+module_param_cb(icc_send, &icc_send_ops, NULL, 0200);
+MODULE_PARM_DESC(icc_send, "VRR test 26: send an HDMI ICC message (hex) right away; vrr_test only");
 module_param_string(vrr_drm, vrr_drm, sizeof(vrr_drm), 0644);
 MODULE_PARM_DESC(vrr_drm, "VRR test 24: DRM InfoFrame bytes (hex) to write at 0x7e40 before the pre-block, empty = none");
 module_param(vrr_vtem, uint, 0644);
