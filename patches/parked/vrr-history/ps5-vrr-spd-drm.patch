PS5 HDMI: VRR test 24, stock's DRM and SPD InfoFrames before the pre-block  [ps5-bazzite-deck]

hsgodd's full capture of stock's VRR-on sequence: the VSync VRR block matches ours, but
between the PHY selectors and the pre-block stock sends two messages our port never
sent: #25 a DRM InfoFrame in the 0x7e40 slot (87 01 1a 5c 02 + zero metadata, also with
HDR off) and #27 an SPD InfoFrame (vendor "SCEI", product "PS5", source 0x08 = game,
strobe 0x7204 bit 5). In the chip's VRR mode only (hdmi.vrr_test=1, vrr_chip=1):
 - hdmi.vrr_spd (default 1): the SPD InfoFrame
 - hdmi.vrr_drm (runtime, hex, default empty): the DRM InfoFrame bytes for 0x7e40, e.g.
   stock's captured bytes; "VRR DRM InfoFrame at 0x7e40" in the log shows what went out
Stock sends no FreeSync packet; ours shares the 0x7e40 slot, so hdmi.vrr_vsif=0 keeps
it off the DRM InfoFrame (24b).
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -8,6 +8,8 @@
 #include <drm/drm_modes.h>
 #include <linux/hdmi.h>
 #include <linux/module.h>
+#include <linux/ctype.h>
+#include <linux/hex.h>
 #include <linux/mutex.h>
 #include <linux/ps5.h>
 #include <drm/drm_edid.h>
@@ -815,6 +817,25 @@
  * 2 VSC_EXT_CEA with PB0.. only, 3 SDP HB1..2 = EMP 7f c0, 4 EMP header as HB0..2.
  */
 static unsigned int vrr_vtem;	/* test 18: off, ruled out by test 17 */
+/*
+ * Test 24 (hsgodd's full capture of stock's VRR-on sequence): between the PHY selectors
+ * and the pre-block, stock sends two messages our port never sent: #25 a DRM InfoFrame
+ * in the 0x7e40 slot (87 01 1a 5c 02 + zero metadata, even with HDR off) and #27 an SPD
+ * InfoFrame (vendor "SCEI", product "PS5", source information 0x08 = game, strobe 0x7204
+ * bit 5), in that order. VRR mode only. Stock sends no FreeSync packet: our FreeSync
+ * InfoFrame also lives in the 0x7e40 slot, so for the native path vrr_vsif=0 keeps it
+ * from overwriting the DRM InfoFrame (hsgodd's 24b; the vendor slot 0x72c0 holds stock's
+ * ALLM HF-VSIF, so the FreeSync packet can't simply move there).
+ * vrr_spd: 1 = send the SPD (default), 0 = not.
+ * vrr_drm: the DRM InfoFrame as hex, written to 0x7e40 at that point (e.g. stock's
+ * captured bytes "87011a5c02..."); empty (default) = not sent. Settable at runtime.
+ */
+static bool vrr_spd = true;
+module_param(vrr_spd, bool, 0644);
+MODULE_PARM_DESC(vrr_spd, "VRR test 24: send stock's SPD InfoFrame (SCEI / PS5 / game) before the pre-block");
+static char vrr_drm[96];
+module_param_string(vrr_drm, vrr_drm, sizeof(vrr_drm), 0644);
+MODULE_PARM_DESC(vrr_drm, "VRR test 24: DRM InfoFrame bytes (hex) to write at 0x7e40 before the pre-block, empty = none");
 module_param(vrr_vtem, uint, 0644);
 MODULE_PARM_DESC(vrr_vtem, "VRR test 17: VTEM to the bridge as a DP SDP, framing 0-4 (default 1)");
 static unsigned int vrr_vtem_pb0 = 0x04;
@@ -1252,6 +1273,41 @@
 	initHdmiPhyForFlava3_1st();
 	initHdmiPhyForFlava3_2nd();
 	mask_7203();
+	if (vrr_mode && vrr_drm[0]) {
+		u8 drm[30];
+		int n = 0;
+		const char *p = vrr_drm;
+
+		while (n < (int)sizeof(drm) && isxdigit(p[0]) && isxdigit(p[1])) {
+			drm[n++] = hex_to_bin(p[0]) << 4 | hex_to_bin(p[1]);
+			p += 2;
+			while (*p == ' ' || *p == ':')
+				p++;
+		}
+		if (n >= 4) {
+			i2c_init(1);
+			i2c_begin_block();
+			i2c_write_data(0x7e40, drm, n);
+			i2c_end_block();
+			i2c_mask(0x7203, 0x01, 0x01);
+			i2c_write(0x7204, 0x01);
+			i2c_waitclear(0x7204, 0x01);
+			i2c_exec();
+			pr_info("VRR DRM InfoFrame at 0x7e40: %*ph\n", n, drm);
+		}
+	}
+	if (vrr_mode && vrr_spd) {
+		static const u8 spd[25] = { 'S', 'C', 'E', 'I', 0, 0, 0, 0, 'P', 'S', '5', [24] = 0x08 };
+
+		i2c_init(1);
+		i2c_begin_block();
+		i2c_write_data(0x7244, (u8 *)spd, sizeof(spd));	/* PB1-8 vendor, PB9-24 product, PB25 source */
+		i2c_write(0x7204, 0x20);
+		i2c_end_block();
+		i2c_waitclear(0x7204, 0x20);
+		i2c_exec();
+		pr_info("VRR SPD: vendor SCEI, product PS5, source 0x08 (game), strobe 0x7204 bit 5\n");
+	}
