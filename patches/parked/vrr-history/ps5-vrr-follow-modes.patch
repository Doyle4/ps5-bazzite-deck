PS5 VRR: follow mode by default, only in modes it carries; timing SDP logged  [ps5-bazzite-deck]

After test 28 (Lawson's follow mode) gave working VRR at 4K60 and 1080p120 on an LG C4
(TV FreeSync following the game), but a black picture at 1440p60 and 1440p120:
 - with hdmi.vrr_test=1, follow mode (vrr_chip=2) is now the default
 - VRR is only offered for modes follow mode carries: known CEA timings with positive
   syncs. 1440p60 (CVT-RB, negative vsync: no timing SDP) and 1440p120 (custom timing
   slot) keep a fixed refresh instead of going black. hdmi.vrr_any_mode=1 tries every
   mode and builds the timing SDP whatever the sync polarity, to test those
 - the timing SDP the GPU sends (or why it isn't sent) is logged once per mode
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -764,7 +764,7 @@
  */
 static bool vrr_vsif = true;
 module_param(vrr_vsif, bool, 0644);
-static unsigned int vrr_chip;
+static unsigned int vrr_chip = 2;	/* 1.6.2: follow mode (test 28, Lawson) is the working path */
 module_param(vrr_chip, uint, 0644);
 MODULE_PARM_DESC(vrr_chip, "VRR: 1 = Sony's VSync block at the mode set (tests 11-27), 2 = follow mode after the GPU's timing SDP (test 28, Lawson), 0 = FreeSync pass-through (default)");
 static bool vrr_requested;
@@ -1001,6 +1001,43 @@
 MODULE_PARM_DESC(vrr_fs_min, "VRR test 28: minimum refresh in the FreeSync SPD (Hz)");
 static bool vrr_follow;
 static unsigned int vrr_follow_hz = 60;
+/*
+ * 1.6.2: follow mode works with the chip's known (CEA) timings with positive syncs, as in
+ * Lawson's tests (4K60, and 1080p120 here); custom timings like 1440p and timings with a
+ * negative sync stay black (1440p60 CVT-RB: -vsync, no timing SDP; 1440p120: custom
+ * timing slot). For those modes VRR isn't offered to the GPU, so the picture stays put.
+ * vrr_any_mode=1 tries every mode (and builds the timing SDP whatever the sync polarity).
+ */
+static bool vrr_any_mode;
+module_param(vrr_any_mode, bool, 0644);
+MODULE_PARM_DESC(vrr_any_mode, "VRR: also try follow mode with custom timings and negative syncs (default off: VRR stays off in those modes)");
+
+bool ps5_hdmi_vrr_any_mode(void)
+{
+	return vrr_any_mode;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_any_mode);
+
+bool ps5_hdmi_vrr_mode_ok(const struct drm_display_mode *mode)
+{
+	static u32 last;
+	bool ok;
+	u32 key;
+
+	if (!ps5_hdmi_vrr_possible() || vrr_chip != 2 || vrr_any_mode || !mode)
+		return true;
+	ok = drm_match_cea_mode(mode) && (mode->flags & DRM_MODE_FLAG_PHSYNC) &&
+	     (mode->flags & DRM_MODE_FLAG_PVSYNC);
+	key = mode->hdisplay << 20 ^ mode->vdisplay << 8 ^ drm_mode_vrefresh(mode) ^ ok << 31;
+	if (key != last) {
+		last = key;
+		pr_info("VRR: %dx%d@%d %s\n", mode->hdisplay, mode->vdisplay, drm_mode_vrefresh(mode),
+			ok ? "supported by follow mode" :
+			"not supported by follow mode yet (custom timing or negative sync): VRR stays off");
+	}
+	return ok;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_mode_ok);
 
 unsigned int ps5_hdmi_vrr_timing_sdp(void)
 {
