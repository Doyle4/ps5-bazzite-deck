PS5 HDMI: VRR test 25b, also send our pre-block after the replayed one  [ps5-bazzite-deck]

hsgodd's capture shows stock's message in the pre-block's place (id 0x0186, 129 bytes)
arms the bridge's VTEM/EMP generator (0x7110 preamble, 0x7011/0x7204 strobes,
0x7225-0x7231), which is different from what our pre-block writes. With
hdmi.vrr_prep_keep=1 ours is sent as well, right after the replayed one (vrr_prep_raw),
in case the chip needs both. Off by default.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -844,6 +844,14 @@
 static char vrr_prep_raw[1024];
 module_param_string(vrr_prep_raw, vrr_prep_raw, sizeof(vrr_prep_raw), 0644);
 MODULE_PARM_DESC(vrr_prep_raw, "VRR test 25: pre-block ICC message as hex, sent 1:1 instead of ours (empty = ours)");
+/*
+ * hsgodd's capture shows stock's message in that place (id 0x0186) arms the bridge's
+ * VTEM/EMP generator, which is different from what our pre-block writes.
+ * vrr_prep_keep=1 sends ours as well, right after the replayed one.
+ */
+static bool vrr_prep_keep;
+module_param(vrr_prep_keep, bool, 0644);
+MODULE_PARM_DESC(vrr_prep_keep, "VRR test 25b: also send our own pre-block after vrr_prep_raw");
 module_param_string(vrr_drm, vrr_drm, sizeof(vrr_drm), 0644);
 MODULE_PARM_DESC(vrr_drm, "VRR test 24: DRM InfoFrame bytes (hex) to write at 0x7e40 before the pre-block, empty = none");
 module_param(vrr_vtem, uint, 0644);
@@ -1364,7 +1372,8 @@
 		} else {
 			pr_info("VRR prep RAW: no usable hex in vrr_prep_raw, nothing sent\n");
 		}
-	} else if (vrr_mode && vrr_prep) {
+	}
+	if (vrr_mode && vrr_prep && (!vrr_prep_raw[0] || vrr_prep_keep)) {
 		/*
 		 * Test 15: the complete stock pre-block message (hsgodd, 0x4b40f3-0x4b4228):
 		 * 7001 = 2|3 (3 here), 7061 = table on the mode id (5a 00 for ours),
