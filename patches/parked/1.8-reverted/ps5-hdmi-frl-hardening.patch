PS5 HDMI: 4K120 hardening (v1.8.3 attempt)  [ps5-bazzite-deck]

hsgodd's LG (same model string as Gilles' C4, announces 4K120 over FRL at 48 Gbit/s) shows no
picture at 4K120 since v1.8 with VRR always on, while 4K60 and 1440p120 work:
 - in FRL modes the VRR follow block waits 1.5 s instead of 100 ms: the setup only starts the
   FRL link, chip and TV then train it, longer than a TMDS link takes
 - 4K120 only as 120.00 Hz: the chip's setup is Sony's for exactly that clock; the 119.88 Hz
   variant of VIC 118 went over the same setup
 - the "over FRL" log line shows the GPU-to-chip format and depth
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -1165,6 +1165,12 @@
 
 #define VRR_FOLLOW_DELAY_MS	100	/* after a setup or a VRR switch: the GPU's timing packet flows by then */
 /*
+ * v1.8.3: at 4K120 the setup only starts the FRL link; the chip and the TV then train it,
+ * which takes longer than a TMDS link. hsgodd's LG showed no picture at 4K120 with VRR on
+ * while the follow block came 100 ms after the setup: wait for the link first.
+ */
+#define VRR_FOLLOW_DELAY_FRL_MS	1500
+/*
  * v1.7.3: VRR never goes below 48 Hz, the PS5 system's own floor (Lawson's notes): below
  * that, frames are doubled at 120 Hz modes, and 60 Hz modes keep a fixed 60 Hz. TVs' own
  * minimum is often 40 Hz, where OLEDs flicker visibly (hsgodd). A TV whose minimum is
@@ -1441,7 +1447,8 @@
 	if (!ps5_hdmi_vrr_possible())
 		return;
 	sceHdmiSetVrrMode(on);
-	mod_delayed_work(system_wq, &vrr_follow_work, msecs_to_jiffies(VRR_FOLLOW_DELAY_MS));
+	mod_delayed_work(system_wq, &vrr_follow_work,
+			 msecs_to_jiffies(READ_ONCE(setup_frl) ? VRR_FOLLOW_DELAY_FRL_MS : VRR_FOLLOW_DELAY_MS));
 }
 EXPORT_SYMBOL(sceHdmiSwitchVrr);
 
@@ -1452,7 +1459,8 @@
 		return;
 	WRITE_ONCE(vrr_follow_pending, true);
 	vrr_follow_hz = mode ? drm_mode_vrefresh(mode) : 60;
-	mod_delayed_work(system_wq, &vrr_follow_work, msecs_to_jiffies(VRR_FOLLOW_DELAY_MS));
+	mod_delayed_work(system_wq, &vrr_follow_work,
+			 msecs_to_jiffies(READ_ONCE(setup_frl) ? VRR_FOLLOW_DELAY_FRL_MS : VRR_FOLLOW_DELAY_MS));
 }
 
 static void setHdmiVideoConfigFlava3(const struct drm_display_mode *mode,
@@ -1474,7 +1482,8 @@
 		configVSyncSettingFlava3();
 	if (ps5_mode_frl(drm_match_cea_mode(mode))) {
 		setVideoAdditionalConfigFrlFlava3();
-		pr_info("hdmi: %dx%d@%d over FRL\n", mode->hdisplay, mode->vdisplay, drm_mode_vrefresh(mode));
+		pr_info("hdmi: %dx%d@%d over FRL (%s, %u bpc)\n", mode->hdisplay, mode->vdisplay,
+			drm_mode_vrefresh(mode), yuv422 ? "YCbCr 4:2:2" : "RGB", bpc);
 	} else {
 		setVideoAdditionalConfigFlava3(mode);
 	}
@@ -1892,8 +1901,8 @@
 	case 63: /* 1080p120 */
 	case 97: /* 2160p60 */
 		return true;
-	case 118: /* 2160p120, FRL */
-		return ps5_mode_frl(vic);
+	case 118: /* 2160p120, FRL: the chip's setup is Sony's for exactly 120.00 Hz, not 119.88 */
+		return ps5_mode_frl(vic) && mode->clock == 1188000;
 	}
 
 	return false;
