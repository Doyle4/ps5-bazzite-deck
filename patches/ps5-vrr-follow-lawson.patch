 		pr_info("HF-VSIF: ALLM on (vendor InfoFrame slot 0x72c0)\n");
 	}
 	setVideoAdditionalConfigFlava3(mode);
+	/* test 28: the follow block once the GPU's timing SDP flows (Lawson) */
