 /* amdgpu says before each video setup whether the mode gets VRR */
+/*
+ * VRR test 28, ported from Lawson's PS5 VRR work (vrr13, 28 Oct: real VRR, the TV's
+ * FreeSync following the game at 40-60 Hz). Three things our native path never did:
+ *  1. the GPU sends Sony's timing SDP every frame (HB 39 04, source timing, in the
+ *     adaptive-sync slot; amdgpu_dm_freesync.c) - without it the chip's follow mode
+ *     (0x6064=03) gives a black picture
+ *  2. DPCD 0x107 bit 7 (MSA_TIMING_PAR_IGNORE_EN) stays clear on the chip: it drops its
+ *     input lock when set; the GPU still varies the frame length (link_dpms.c)
+ *  3. the chip is switched to follow mode only after the SDP flows, step by step, plus
+ *     a FreeSync SPD in the chip's SPD slot 0x7240 for the TV
+ * vrr_chip=2 selects this: the setup itself stays normal, the follow block comes after.
+ */
+static unsigned int vrr_timing_sdp = 1;
+module_param(vrr_timing_sdp, uint, 0644);
+MODULE_PARM_DESC(vrr_timing_sdp, "VRR test 28: Sony timing SDP (39 04) from the GPU while VRR is active: 1 instead of the FreeSync SDP (default), 2 both, 0 off");
+static bool vrr_sink_msa;
+module_param(vrr_sink_msa, bool, 0644);
+MODULE_PARM_DESC(vrr_sink_msa, "VRR test 28: set DPCD 0x107 MSA-ignore on the chip (default off: the chip drops its input lock)");
+static unsigned int vrr_follow_ms = 1000;
+module_param(vrr_follow_ms, uint, 0644);
+MODULE_PARM_DESC(vrr_follow_ms, "VRR test 28: delay before and between the follow-mode steps (ms)");
+static unsigned int vrr_fs_min = 40;
+module_param(vrr_fs_min, uint, 0644);
+MODULE_PARM_DESC(vrr_fs_min, "VRR test 28: minimum refresh in the FreeSync SPD (Hz)");
+static bool vrr_follow;
+static unsigned int vrr_follow_hz = 60;
+
+unsigned int ps5_hdmi_vrr_timing_sdp(void)
+{
+	return ps5_hdmi_vrr_possible() ? vrr_timing_sdp : 0;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_timing_sdp);
+
+bool ps5_hdmi_vrr_keep_sink_msa(void)
+{
+	return ps5_hdmi_vrr_possible() && !vrr_sink_msa;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_keep_sink_msa);
+
+/* one I2C program to the chip, without the shared i2c_ctx (runs from a work item) */
+static int vrr_icc(const u8 *body, int n)
+{
+	static u8 buf[ICC_MSG_MAX_SIZE];
+	static DEFINE_MUTEX(lock);
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int ret;
+
+	mutex_lock(&lock);
+	memset(buf, 0, sizeof(buf));
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->length = sizeof(*msg) + n;
+	memcpy(msg->data, body, n);
+	if (icc_trace)
+		icc_trace_dump("query", buf);
+	ret = icc_query(buf, buf);
+	if (!ret && buf[0xc])
+		ret = -EIO;
+	mutex_unlock(&lock);
+	return ret;
+}
+
+/* body of one block write: code 1, one 2/2 command with one register */
+static int vrr_icc_write(u16 reg, const u8 *data, int len)
+{
+	u8 b[48];
+	int n = 0;
+
+	b[n++] = 0x01; b[n++] = 0; b[n++] = 0; b[n++] = 1;	/* code, length (below), count */
+	b[n++] = 0x02; b[n++] = 4 + 3 + len; b[n++] = 0x02; b[n++] = 1;
+	b[n++] = len; b[n++] = reg >> 8; b[n++] = reg & 0xff;
+	memcpy(b + n, data, len);
+	n += len;
+	b[1] = n & 0xff; b[2] = n >> 8;
+	return vrr_icc(b, n);
+}
+
+static void vrr_follow_fn(struct work_struct *work)
+{
+	static const struct { u16 reg; u8 len; u8 v[2]; } steps[] = {
+		{ 0x6064, 1, { 0x03 } }, { 0x1047, 1, { 0x30 } }, { 0x600c, 2, { 0x01, 0x00 } },
+		{ 0x6224, 2, { 0x40, 0x0f } }, { 0x6c07, 1, { 0x80 } },
+	};
+	u8 spd[30] = { 0x83, 0x01, 0x08, 0, 0x1a, 0, 0, 0, 0, 0x07 };
+	u8 b[64];
+	int i, n = 0, ret, sum = 0;
+
+	if (!READ_ONCE(vrr_follow))
+		return;
+	/* FreeSync SPD (AMD OUI, supported|enabled|active, min, max) in the chip's SPD slot */
+	spd[10] = vrr_fs_min;
+	spd[11] = vrr_follow_hz;
+	for (i = 0; i < 12; i++)
+		sum += spd[i];
+	spd[3] = (256 - (sum & 0xff)) & 0xff;
+	b[n++] = 0x01; b[n++] = 0; b[n++] = 0; b[n++] = 3;
+	b[n++] = 0x02; b[n++] = 4 + 3 + 30; b[n++] = 0x02; b[n++] = 1;
+	b[n++] = 30; b[n++] = 0x72; b[n++] = 0x40;
+	memcpy(b + n, spd, 30); n += 30;
+	b[n++] = 0x02; b[n++] = 9; b[n++] = 0x03; b[n++] = 1;		/* mask 0x7203 |= 0x20 */
+	b[n++] = 1; b[n++] = 0x72; b[n++] = 0x03; b[n++] = 0x20; b[n++] = 0x20;
+	b[n++] = 0x02; b[n++] = 8; b[n++] = 0x02; b[n++] = 1;		/* 0x7204 = 0x20 */
+	b[n++] = 1; b[n++] = 0x72; b[n++] = 0x04; b[n++] = 0x20;
+	b[1] = n & 0xff; b[2] = n >> 8;
+	ret = vrr_icc(b, n);
+	pr_info("VRR follow: FreeSync SPD %u-%u Hz in 0x7240 (ret %d)\n", vrr_fs_min, vrr_follow_hz, ret);
+	for (i = 0; i < ARRAY_SIZE(steps); i++) {
+		msleep(vrr_follow_ms);
+		if (!READ_ONCE(vrr_follow))
+			return;
+		ret = vrr_icc_write(steps[i].reg, steps[i].v, steps[i].len);
+		pr_info("VRR follow: 0x%04x = %*ph (ret %d)\n", steps[i].reg, steps[i].len, steps[i].v, ret);
+	}
+}
+static DECLARE_DELAYED_WORK(vrr_follow_work, vrr_follow_fn);
+
 void sceHdmiSetVrrMode(bool on)
 {
 	vrr_requested = on;
-	vrr_mode = on && vrr_chip && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+	vrr_mode = on && vrr_chip == 1 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+	WRITE_ONCE(vrr_follow, on && vrr_chip == 2 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3);
+	if (!vrr_follow)
+		cancel_delayed_work(&vrr_follow_work);
 }
 EXPORT_SYMBOL(sceHdmiSetVrrMode);
 
