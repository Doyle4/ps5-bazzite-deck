PS5 HDMI: full ICC trace for VRR research (hdmi.icc_trace)      [ps5-bazzite-deck]

Test 21 settled it (hsgodd): the GPU does DRR (vblank 8.3-25 ms, a steady 16.7 ms at a
60 fps cap) and stock drives this bridge to real HDMI VRR on the same LG, so the gap is
how Sony programs the bridge over ICC. This is the Linux half of the stock-vs-Linux
diff: with hdmi.icc_trace=1 (runtime, off by default) every HDMI ICC query and reply is
logged in full as hex, numbered, so a mode set or VRR switch on Linux can be compared
message by message with the stock dump (ids 0x92-0x9b). On top of v1.5.3.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -192,6 +192,24 @@
 
 /* VRR test 18: the last ICC query and reply, so a caller can read values the bridge reports */
 static u8 i2c_last_query[48], i2c_last_reply[48];
+/*
+ * VRR test 22: a full trace of every HDMI ICC query and reply (the Linux side of hsgodd's
+ * stock-vs-Linux ICC diff, messages 0x92-0x9b per mode set on stock). Off by default;
+ * echo 1 > /sys/module/hdmi/parameters/icc_trace, then switch VRR or the mode.
+ */
+static bool icc_trace;
+module_param(icc_trace, bool, 0644);
+MODULE_PARM_DESC(icc_trace, "VRR test 22: log every HDMI ICC query and reply in full (hex)");
+static unsigned int icc_trace_n;
+
+static void icc_trace_dump(const char *dir, const u8 *buf)
+{
+	const struct icc_msg *m = (const struct icc_msg *)buf;
+	unsigned int len = min_t(unsigned int, m->length, ICC_MSG_MAX_SIZE);
+
+	pr_info("ICC %s #%u: %u bytes\n", dir, icc_trace_n, len);
+	print_hex_dump(KERN_INFO, dir[0] == 'q' ? "ICC q " : "ICC r ", DUMP_PREFIX_OFFSET, 16, 1, buf, len, false);
+}
 
 static int i2c_exec(void)
 {
@@ -207,11 +225,17 @@
 	memcpy(msg->data, i2c_ctx.msg_hdr, i2c_ctx.msg_hdr->length);
 	memcpy(i2c_last_query, buf, sizeof(i2c_last_query));
 	memset(i2c_last_reply, 0, sizeof(i2c_last_reply));
+	if (icc_trace) {
+		icc_trace_n++;
+		icc_trace_dump("query", buf);
+	}
 
 	ret = icc_query(buf, buf);
 	if (ret)
 		return ret;
 	memcpy(i2c_last_reply, buf, sizeof(i2c_last_reply));
+	if (icc_trace)
+		icc_trace_dump("reply", buf);
 
 	return 0;
 }
