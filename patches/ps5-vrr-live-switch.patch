+/*
+ * v1.8.1: the chip switches in one go, as stock writes its VSync block in one message and as a
+ * PC's VRR switch is immediate: the five registers in a single block write (they were 250 ms
+ * apart), and switching VRR on or off no longer re-runs the whole HDMI setup (amdgpu_dm.c),
+ * so no black screen; only a mode set still goes through the setup.
+ */
+struct vrr_reg { u16 reg; u8 len; u8 v[2]; };
+
+static int vrr_icc_regs(const struct vrr_reg *r, int count)
+{
+	u8 b[64];
+	int i, n = 8;
+
+	for (i = 0; i < count; i++) {
+		b[n++] = r[i].len; b[n++] = r[i].reg >> 8; b[n++] = r[i].reg & 0xff;
+		memcpy(b + n, r[i].v, r[i].len);
+		n += r[i].len;
+	}
+	b[0] = 0x01; b[1] = n & 0xff; b[2] = n >> 8; b[3] = 1;		/* code, length, 1 command */
+	b[4] = 0x02; b[5] = n - 4; b[6] = 0x02; b[7] = count;		/* block write, count registers */
+	return vrr_icc(b, n);
+}
