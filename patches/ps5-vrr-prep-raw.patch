 static char vrr_drm[96];
+/*
+ * Test 25 (hsgodd): every visible stock message is now replicated except the pre-block
+ * (stock id ~0x018d), whose 4K-lifted constants (0x7061, 0x7215, 0x6207, 0x621b, 0x7070)
+ * may be wrong for other modes. vrr_prep_raw: the captured pre-block as hex, sent 1:1
+ * instead of ours. Either the whole ICC query (12-byte header first, it is replaced) or
+ * just the I2C body after it. Runtime; empty (default) = our own pre-block.
+ */
+static char vrr_prep_raw[1024];
+module_param_string(vrr_prep_raw, vrr_prep_raw, sizeof(vrr_prep_raw), 0644);
+MODULE_PARM_DESC(vrr_prep_raw, "VRR test 25: pre-block ICC message as hex, sent 1:1 instead of ours (empty = ours)");
